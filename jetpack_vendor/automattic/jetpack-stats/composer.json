{
	"name": "automattic/jetpack-stats",
	"description": "Collect valuable traffic stats and insights.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-connection": "^6.7.4",
		"automattic/jetpack-constants": "^3.0.4",
		"automattic/jetpack-status": "^5.0.7"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^1.1.1",
		"automattic/jetpack-changelogger": "^6.0.1",
		"automattic/jetpack-test-environment": "@dev",
		"automattic/phpunit-select-config": "^1.0.0"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Automattic\\Jetpack\\Stats\\": "tests/php"
		}
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-stats",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-package-version.php"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-stats/compare/v${old}...v${new}"
		},
		"branch-alias": {
			"dev-trunk": "0.15.x-dev"
		},
		"textdomain": "jetpack-stats"
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
